# ─── Application ─────────────────────────────────────────────────────────────
APP_ENV=development
APP_SECRET=change-me-to-a-long-random-string-32chars
APP_URL=http://localhost

# ─── Nginx ────────────────────────────────────────────────────────────────────
NGINX_PORT=80

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=mysql
DB_PORT=3306
DB_NAME=mathex
DB_USER=mathex
DB_PASSWORD=mathex_secret
DB_ROOT_PASSWORD=root_secret

# ─── Redis ────────────────────────────────────────────────────────────────────
REDIS_HOST=redis
REDIS_PORT=6379

# ─── Mail (Mailpit for local dev) ─────────────────────────────────────────────
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=noreply@mathex.cz
MAIL_FROM_NAME="Mathex.cz"
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# ─── Adminer ──────────────────────────────────────────────────────────────────
ADMINER_PORT=8080

# ─── Admin credentials (change before first use) ──────────────────────────────
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-in-seeds
