{
    "name": "mathex/website",
    "description": "Mathex.cz – personal website of a Czech freelance IT developer",
    "type": "project",
    "license": "proprietary",
    "require": {
        "php": ">=8.2",
        "nette/application": "^3.2",
        "nette/bootstrap": "^3.2",
        "nette/caching": "^3.3",
        "nette/database": "^3.2",
        "nette/di": "^3.1",
        "nette/forms": "^3.2",
        "nette/http": "^3.3",
        "nette/mail": "^4.0",
        "nette/routing": "^3.1",
        "nette/security": "^3.2",
        "nette/utils": "^4.0",
        "latte/latte": "^3.0",
        "tracy/tracy": "^2.10",
        "contributte/console": "^0.10",
        "contributte/redis": "^0.6",
        "contributte/translation": "^2.0",
        "monolog/monolog": "^3.0",
        "league/commonmark": "^2.4",
        "robmorgan/phinx": "^0.16"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0",
        "nette/tester": "^2.5",
        "phpstan/phpstan": "^1.10",
        "phpstan/phpstan-nette": "^1.3"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "stan": "vendor/bin/phpstan analyse",
        "migrate": "vendor/bin/phinx migrate",
        "rollback": "vendor/bin/phinx rollback",
        "seed": "vendor/bin/phinx seed:run"
    },
    "config": {
        "optimize-autoloader": true,
        "sort-packages": true,
        "allow-plugins": {
            "composer/package-versions-deprecated": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
