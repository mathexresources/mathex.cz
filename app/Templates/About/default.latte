{block content}

<section class="page-header">
    <div class="container">
        <div class="page-header__eyebrow">O mně</div>
        <h1>{$pageTitle}</h1>
        <p class="page-header__lead">PHP vývojář, který kóduje jako řemeslník a komunikuje jako člověk.</p>
    </div>
</section>

{* ─── Bio ─────────────────────────────────────────────────────────────────────── *}
<section class="section section--bio">
    <div class="container">
        <div class="bio-layout">
            <div class="bio-layout__photo reveal reveal--left">
                <img src="/assets/images/avatar.jpg" alt="Mathex – PHP developer" class="bio-photo" loading="lazy">
                <a href="{$cvUrl}" download class="btn btn-outline btn--full" style="margin-top:1rem;">
                    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
                    Stáhnout CV (PDF)
                </a>
            </div>
            <div class="bio-layout__text reveal reveal--right">
                <span class="section__eyebrow">Ahoj, jsem</span>
                <h2>Mathex 👋</h2>
                <p>
                    Freelance PHP a Nette vývojář se sídlem v ČR. Pomáhám firmám i startupům
                    budovat robustní webové aplikace – od architektury přes vývoj po nasazení na produkci.
                </p>
                <p>
                    Specializuji se na Nette Framework, MySQL, REST API a Vue.js.
                    Zakládám si na čistém kódu, dobrých testech a transparentní komunikaci.
                    Pracuji jako skutečný partner, ne jako black box.
                </p>
                <p>
                    Když nepíšu kód, najdete mě na kole, u zajímavých knih nebo na PHP konferencích.
                </p>
                <div class="bio-layout__links">
                    <a href="https://github.com/mathex" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        GitHub
                    </a>
                    <a href="https://linkedin.com/in/mathex" target="_blank" rel="noopener" class="btn btn-outline btn-sm">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        LinkedIn
                    </a>
                    <a href="{link Meeting:}" class="btn btn-primary btn-sm">Rezervovat call</a>
                </div>
            </div>
        </div>
    </div>
</section>

{* ─── Skills ──────────────────────────────────────────────────────────────────── *}
{if $skillsGrouped}
<section class="section section--skills" style="background: var(--c-bg-card); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border);">
    <div class="container">
        <div class="section__title-group reveal text-center">
            <span class="section__eyebrow">Technologie</span>
            <h2 class="section__title">Dovednosti & nástroje</h2>
        </div>
        <div class="skills-groups">
            {foreach $skillsGrouped as $category => $items}
            <div class="reveal">
                <h3 class="skills-group__title">{$category}</h3>
                <ul class="skills-list">
                    {foreach $items as $skill}
                    <li class="skills-list__item">
                        {if $skill->icon_class}<span class="skills-list__icon">{$skill->icon_class}</span>{/if}
                        <span class="skills-list__name">{$skill->name}</span>
                        {if $skill->level}
                        <div class="skills-list__bar" title="{$skill->level}%" role="progressbar" aria-valuenow="{$skill->level}" aria-valuemin="0" aria-valuemax="100">
                            <div class="skills-list__fill"></div>
                        </div>
                        {/if}
                    </li>
                    {/foreach}
                </ul>
            </div>
            {/foreach}
        </div>
    </div>
</section>
{/if}

{* ─── Timeline ────────────────────────────────────────────────────────────────── *}
<section class="section section--timeline">
    <div class="container">
        <div class="section__title-group reveal">
            <span class="section__eyebrow">Zkušenosti</span>
            <h2 class="section__title">Zkušenosti & vzdělání</h2>
        </div>
        <ol class="timeline reveal">
            {foreach $timeline as $item}
            <li class="timeline__item">
                <span class="timeline__year">{$item['year']}</span>
                <div class="timeline__content">
                    <h3 class="timeline__title">{$item['title']}</h3>
                    <p class="timeline__desc">{$item['description']}</p>
                </div>
            </li>
            {/foreach}
        </ol>
    </div>
</section>

{* ─── Values ──────────────────────────────────────────────────────────────────── *}
<section class="section section--values" style="background: var(--c-bg-card); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border);">
    <div class="container">
        <div class="section__title-group reveal text-center">
            <span class="section__eyebrow">Přístup</span>
            <h2 class="section__title">Moje hodnoty</h2>
        </div>
        <div class="values-grid">
            {foreach $values as $i => $value}
            <div class="value-card reveal reveal--delay-{min($i + 1, 4)}">
                <span class="value-card__icon">{$value['icon']}</span>
                <h3 class="value-card__title">{$value['title']}</h3>
                <p class="value-card__desc">{$value['description']}</p>
            </div>
            {/foreach}
        </div>
    </div>
</section>

{* ─── CTA ─────────────────────────────────────────────────────────────────────── *}
<section class="section section--cta">
    <div class="container">
        <div class="cta-box reveal">
            <h2>Pojďme spolupracovat</h2>
            <p>Rezervujte si bezplatný discovery call nebo si stáhněte moje CV.</p>
            <div class="cta-box__actions">
                <a href="{link Meeting:}" class="btn btn-primary btn--large">Rezervovat call</a>
                <a href="{$cvUrl}" download class="btn btn-outline">Stáhnout CV</a>
            </div>
        </div>
    </div>
</section>

{/block}
