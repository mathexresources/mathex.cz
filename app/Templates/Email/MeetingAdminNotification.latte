<!DOCTYPE html>
<html lang="cs">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Nová žádost o schůzku</title>
</head>
<body style="margin:0;padding:0;background:#f1f5f9;font-family:'Segoe UI',Arial,sans-serif;">
<table width="100%" cellpadding="0" cellspacing="0" style="background:#f1f5f9;padding:40px 20px;">
  <tr><td align="center">
    <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff;border-radius:8px;overflow:hidden;box-shadow:0 2px 8px rgba(0,0,0,0.08);">

      <tr>
        <td style="background:#0f172a;padding:28px 40px;">
          <p style="margin:0;font-family:'Courier New',monospace;font-size:22px;font-weight:700;color:#22d3ee;letter-spacing:-0.03em;">{$siteTitle}</p>
          <p style="margin:6px 0 0;font-size:13px;color:#64748b;">Administrátorské oznámení</p>
        </td>
      </tr>

      <tr>
        <td style="background:#eff6ff;border-bottom:3px solid #6366f1;padding:20px 40px;">
          <p style="margin:0;font-size:18px;font-weight:700;color:#3730a3;">🗓 Nová žádost o schůzku</p>
          <p style="margin:4px 0 0;font-size:13px;color:#4338ca;">od {$meeting->name}</p>
        </td>
      </tr>

      <tr>
        <td style="padding:32px 40px;">
          <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:24px;">
            <tr><td style="padding:20px 24px;">
              <p style="margin:0 0 14px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Kontaktní údaje</p>
              <table width="100%" cellpadding="0" cellspacing="0">
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;width:130px;vertical-align:top;">Jméno</td>
                  <td style="padding:4px 0;font-size:14px;color:#1e293b;font-weight:600;">{$meeting->name}</td>
                </tr>
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;vertical-align:top;">E-mail</td>
                  <td style="padding:4px 0;font-size:14px;"><a href="mailto:{$meeting->email}" style="color:#6366f1;text-decoration:none;">{$meeting->email}</a></td>
                </tr>
                {if $meeting->phone}
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;vertical-align:top;">Telefon</td>
                  <td style="padding:4px 0;font-size:14px;"><a href="tel:{$meeting->phone}" style="color:#6366f1;text-decoration:none;">{$meeting->phone}</a></td>
                </tr>
                {/if}
                {if $meeting->company}
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;vertical-align:top;">Firma</td>
                  <td style="padding:4px 0;font-size:14px;color:#1e293b;">{$meeting->company}</td>
                </tr>
                {/if}
              </table>
            </td></tr>
          </table>

          <table width="100%" cellpadding="0" cellspacing="0" style="background:#f8fafc;border:1px solid #e2e8f0;border-radius:6px;margin-bottom:24px;">
            <tr><td style="padding:20px 24px;">
              <p style="margin:0 0 14px;font-size:12px;font-weight:700;text-transform:uppercase;letter-spacing:0.08em;color:#94a3b8;">Detaily požadavku</p>
              <table width="100%" cellpadding="0" cellspacing="0">
                {if $meeting->service_type}
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;width:130px;vertical-align:top;">Typ služby</td>
                  <td style="padding:4px 0;font-size:14px;color:#1e293b;">{$meeting->service_type}</td>
                </tr>
                {/if}
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;vertical-align:top;">Preferovaný datum</td>
                  <td style="padding:4px 0;font-size:14px;color:#1e293b;font-weight:600;">
                    {if $meeting->preferred_date}{date('j. n. Y', strtotime((string) $meeting->preferred_date))}{else}Neuvedeno{/if}
                  </td>
                </tr>
                <tr>
                  <td style="padding:4px 0;font-size:14px;color:#64748b;vertical-align:top;">Preferovaný čas</td>
                  <td style="padding:4px 0;font-size:14px;color:#1e293b;font-weight:600;">
                    {if $meeting->preferred_time}{date('H:i', strtotime((string) $meeting->preferred_time))}{else}Neuvedeno{/if}
                  </td>
                </tr>
                {if $meeting->message}
                <tr>
                  <td style="padding:8px 0 4px;font-size:14px;color:#64748b;vertical-align:top;">Zpráva</td>
                  <td style="padding:8px 0 4px;font-size:14px;color:#1e293b;line-height:1.6;">{$meeting->message|nl2brEscape|noescape}</td>
                </tr>
                {/if}
              </table>
            </td></tr>
          </table>

          <a href="{$adminUrl}" style="display:inline-block;background:#22d3ee;color:#0f172a;font-size:15px;font-weight:700;padding:12px 28px;border-radius:6px;text-decoration:none;">
            Zobrazit v administraci →
          </a>
        </td>
      </tr>

      <tr>
        <td style="background:#f8fafc;border-top:1px solid #e2e8f0;padding:16px 40px;">
          <p style="margin:0;font-size:12px;color:#94a3b8;">Automatické oznámení ze systému {$siteTitle} · <a href="{$adminUrl}" style="color:#64748b;">{$adminUrl}</a></p>
        </td>
      </tr>

    </table>
  </td></tr>
</table>
</body>
</html>
