{block content}
<section class="page-header">
    <div class="container">
        <h1>{$pageTitle}</h1>
        <p class="page-header__lead">Přehled webových aplikací, e-shopů a API, na kterých jsem pracoval.</p>
    </div>
</section>

<section class="section">
    <div class="container">
        {if $projects->count() > 0}
            <div class="projects-grid projects-grid--full">
                {foreach $projects as $project}
                <article class="project-card">
                    {if $project->cover_image}
                        <a href="{link detail $project->slug}" class="project-card__image-link">
                            <img src="{$project->cover_image}" alt="{$project->title}" class="project-card__image" loading="lazy">
                        </a>
                    {/if}
                    <div class="project-card__body">
                        <h2 class="project-card__title">
                            <a href="{link detail $project->slug}">{$project->title}</a>
                        </h2>
                        {if $project->{'description_' . $locale}}
                            <p class="project-card__desc">{$project->{'description_' . $locale}}</p>
                        {/if}
                        {if $project->technologies}
                            <ul class="tag-list">
                                {foreach json_decode($project->technologies, true) ?? [] as $tech}
                                    <li class="tag">{trim($tech)}</li>
                                {/foreach}
                            </ul>
                        {/if}
                        <a href="{link detail $project->slug}" class="btn btn-sm btn-outline">Detail →</a>
                    </div>
                </article>
                {/foreach}
            </div>
        {else}
            <p class="empty-state">Zatím žádné projekty. Brzy přidám!</p>
        {/if}
    </div>
</section>
{/block}
