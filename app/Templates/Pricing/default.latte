{block content}

<section class="page-header">
    <div class="container">
        <div class="page-header__eyebrow">Ceník</div>
        <h1>{$pageTitle}</h1>
        <p class="page-header__lead">Transparentní ceny. Žádné skryté poplatky. Vždy víte, co platíte.</p>
    </div>
</section>

{* Pricing plans *}
<section class="section">
    <div class="container">
        <div class="section__title-group reveal text-center">
            <span class="section__eyebrow">Plány</span>
            <h2 class="section__title">Vyberte si, co vám sedí</h2>
            <p class="section__lead">Orientační ceny – každý projekt je jiný. Nezávazně probereme na callu.</p>
        </div>

        {if $servicesWithPricing}
        <div class="pricing-grid">
            {foreach $servicesWithPricing as $sp}
                {foreach $sp['plans'] as $i => $plan}
                <div class="pricing-card {if $plan->highlighted ?? false}pricing-card--featured{/if} reveal reveal--delay-{min($i + 1, 3)}">
                    {if $plan->highlighted ?? false}
                        <span class="pricing-card__badge">Nejoblíbenější</span>
                    {/if}
                    <div class="pricing-card__header">
                        <h2 class="pricing-card__name">{$plan->{'name_' . $locale}}</h2>
                    </div>
                    <div class="pricing-card__price">
                        {if $plan->price_from}
                            <span class="pricing-card__amount">od {number_format($plan->price_from, 0, ',', ' ')} Kč</span>
                        {else}
                            <span class="pricing-card__amount">Dle dohody</span>
                        {/if}
                        {if $plan->billing_type}<span class="pricing-card__period">{$plan->billing_type}</span>{/if}
                    </div>
                    {if $plan->{'features_' . $locale}}
                    <ul class="pricing-card__features">
                        {foreach json_decode($plan->{'features_' . $locale}, true) ?? [] as $feature}
                            <li class="pricing-card__feature">{$feature}</li>
                        {/foreach}
                    </ul>
                    {/if}
                    <div class="pricing-card__cta">
                        <a href="{link Meeting:}" class="btn btn--full {if $plan->highlighted ?? false}btn-primary{else}btn-outline{/if}">
                            Nezávazná poptávka
                        </a>
                    </div>
                </div>
                {/foreach}
            {/foreach}
        </div>
        {else}
        {* Fallback placeholder cards *}
        <div class="pricing-grid">
            <div class="pricing-card reveal reveal--delay-1">
                <div class="pricing-card__header">
                    <h2 class="pricing-card__name">Starter</h2>
                    <p class="pricing-card__desc">Prezentační web nebo landing page</p>
                </div>
                <div class="pricing-card__price">
                    <span class="pricing-card__amount">od 25 000 Kč</span>
                    <span class="pricing-card__period">jednorázově</span>
                </div>
                <ul class="pricing-card__features">
                    <li class="pricing-card__feature">Responzivní design</li>
                    <li class="pricing-card__feature">CMS (Nette admin)</li>
                    <li class="pricing-card__feature">SEO optimalizace</li>
                    <li class="pricing-card__feature">Nasazení na server</li>
                </ul>
                <div class="pricing-card__cta">
                    <a href="{link Meeting:}" class="btn btn-outline btn--full">Nezávazná poptávka</a>
                </div>
            </div>

            <div class="pricing-card pricing-card--featured reveal reveal--delay-2">
                <span class="pricing-card__badge">Nejoblíbenější</span>
                <div class="pricing-card__header">
                    <h2 class="pricing-card__name">Business</h2>
                    <p class="pricing-card__desc">Webová aplikace nebo e-shop na míru</p>
                </div>
                <div class="pricing-card__price">
                    <span class="pricing-card__amount">od 80 000 Kč</span>
                    <span class="pricing-card__period">jednorázově</span>
                </div>
                <ul class="pricing-card__features">
                    <li class="pricing-card__feature">Kompletní vývoj na míru</li>
                    <li class="pricing-card__feature">Platební brána</li>
                    <li class="pricing-card__feature">REST API</li>
                    <li class="pricing-card__feature">Testování & dokumentace</li>
                    <li class="pricing-card__feature">3 měsíce podpory</li>
                </ul>
                <div class="pricing-card__cta">
                    <a href="{link Meeting:}" class="btn btn-primary btn--full">Nezávazná poptávka</a>
                </div>
            </div>

            <div class="pricing-card reveal reveal--delay-3">
                <div class="pricing-card__header">
                    <h2 class="pricing-card__name">Enterprise</h2>
                    <p class="pricing-card__desc">Komplexní systémy a dlouhodobá spolupráce</p>
                </div>
                <div class="pricing-card__price">
                    <span class="pricing-card__amount">Dle dohody</span>
                    <span class="pricing-card__period">hodinová nebo projektová sazba</span>
                </div>
                <ul class="pricing-card__features">
                    <li class="pricing-card__feature">Technická konzultace</li>
                    <li class="pricing-card__feature">Code review & audit</li>
                    <li class="pricing-card__feature">Integrace třetích stran</li>
                    <li class="pricing-card__feature">Dlouhodobá podpora</li>
                    <li class="pricing-card__feature">SLA & prioritní podpora</li>
                </ul>
                <div class="pricing-card__cta">
                    <a href="{link Meeting:}" class="btn btn-outline btn--full">Domluvit schůzku</a>
                </div>
            </div>
        </div>
        <p class="empty-state" style="padding:1.5rem 0;">Výše uvedené jsou orientační ceny. <a href="{link Contact:}">Napište mi</a> pro individuální nabídku.</p>
        {/if}
    </div>
</section>

{* FAQ *}
<section class="section section--faq" style="background: var(--c-bg-card); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border);">
    <div class="container">
        <div class="section__title-group reveal text-center">
            <span class="section__eyebrow">FAQ</span>
            <h2 class="section__title">Časté otázky</h2>
        </div>
        <div class="faq-list reveal">
            {foreach $faqs as $i => $faq}
            <details class="faq-item" {if $i === 0}open{/if}>
                <summary class="faq-item__question">{$faq['question']}</summary>
                <div class="faq-item__answer">
                    <p>{$faq['answer']}</p>
                </div>
            </details>
            {else}
            {* Default FAQ items *}
            <details class="faq-item" open>
                <summary class="faq-item__question">Jak probíhá spolupráce?</summary>
                <div class="faq-item__answer">
                    <p>Začínáme bezplatným 30minutovým discovery callem, kde probereme váš projekt. Následuje návrh řešení a cenová nabídka. Po odsouhlasení začínáme vývoj s pravidelnými aktualizacemi.</p>
                </div>
            </details>
            <details class="faq-item">
                <summary class="faq-item__question">Jak dlouho trvá vývoj webu?</summary>
                <div class="faq-item__answer">
                    <p>Prezentační web: 3–6 týdnů. Komplexní aplikace nebo e-shop: 2–6 měsíců. Záleží na rozsahu a vašich požadavcích. Přesný timeline upřesníme po analýze projektu.</p>
                </div>
            </details>
            <details class="faq-item">
                <summary class="faq-item__question">Co je zahrnuto v ceně?</summary>
                <div class="faq-item__answer">
                    <p>Vývoj, testování, nasazení na server, základní SEO nastavení a dokumentace. Podpora po dokončení projektu je zahrnuta podle zvoleného plánu (obvykle 1–3 měsíce).</p>
                </div>
            </details>
            <details class="faq-item">
                <summary class="faq-item__question">Mohu projekt financovat po etapách?</summary>
                <div class="faq-item__answer">
                    <p>Ano. Pro větší projekty (nad 50 000 Kč) nabízím splátkový kalendář: záloha při podpisu smlouvy, průběžné platby po milnících, doplatek při předání.</p>
                </div>
            </details>
            <details class="faq-item">
                <summary class="faq-item__question">Mohu web po dokončení spravovat sám?</summary>
                <div class="faq-item__answer">
                    <p>Ano. Každý projekt dostane administrační rozhraní pro správu obsahu. Pokud chcete, připravím i školení pro váš tým.</p>
                </div>
            </details>
            {/foreach}
        </div>
    </div>
</section>

{* CTA *}
<section class="section section--cta">
    <div class="container">
        <div class="cta-box reveal">
            <h2>Připraveni začít?</h2>
            <p>Rezervujte si bezplatný 30minutový call a probereme váš projekt.</p>
            <div class="cta-box__actions">
                <a href="{link Meeting:}" class="btn btn-primary btn--large">Rezervovat call</a>
                <a href="{link Contact:}" class="btn btn-outline">Napsat zprávu</a>
            </div>
        </div>
    </div>
</section>

{/block}
