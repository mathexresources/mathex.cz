<!DOCTYPE html>
<html lang="cs">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{$title} | Mathex.cz</title>
    <style>
        * { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: system-ui, sans-serif; background: #0f172a; color: #e2e8f0; display: flex; align-items: center; justify-content: center; min-height: 100vh; padding: 2rem; }
        .error-box { text-align: center; max-width: 480px; }
        .error-code { font-size: 8rem; font-weight: 800; line-height: 1; color: #6366f1; }
        h1 { font-size: 1.5rem; margin: 1rem 0 0.5rem; }
        p { color: #94a3b8; margin-bottom: 2rem; }
        a { display: inline-block; padding: 0.75rem 1.5rem; background: #6366f1; color: #fff; text-decoration: none; border-radius: 0.5rem; font-weight: 600; }
        a:hover { background: #4f46e5; }
    </style>
</head>
<body>
<div class="error-box">
    <div class="error-code">{$code}</div>
    <h1>{$title}</h1>
    <p>{$message}</p>
    <a href="/">← Zpět na úvod</a>
</div>
</body>
</html>
