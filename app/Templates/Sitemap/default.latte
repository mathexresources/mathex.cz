{layout none}
<?xml version="1.0" encoding="UTF-8"?>
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9">
{foreach $urls as $url}
    <url>
        <loc>{$url['loc']|noescape}</loc>
        {if isset($url['lastmod'])}<lastmod>{$url['lastmod']}</lastmod>{/if}
        {if isset($url['changefreq'])}<changefreq>{$url['changefreq']}</changefreq>{/if}
        {if isset($url['priority'])}<priority>{$url['priority']}</priority>{/if}
    </url>
{/foreach}
</urlset>
