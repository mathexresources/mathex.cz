{block extraHead}
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/themes/prism-tomorrow.min.css">
{/block}

{block content}

{if $previewMode}
<div class="preview-banner" role="alert">
    <strong>Náhled konceptu</strong> – tento článek ještě není publikován.
    <a href="{link //Admin:Blog:edit $post->id}">Zpět do editoru</a>
</div>
{/if}

<article class="post-detail" itemscope itemtype="https://schema.org/Article">

    <header class="page-header">
        <div class="container">
            <a href="{link default}" class="back-link">← Zpět na blog</a>
            <div class="post-detail__meta">
                <time datetime="{$post->published_at}" itemprop="datePublished">
                    {$post->published_at|date:'j. n. Y'}
                </time>
                <span class="post-detail__reading-time">⏱ {$readingTime} min čtení</span>
                <span class="post-detail__views">👁 {$post->views_count} zobrazení</span>
                {if $commentCount > 0}
                    <span class="post-detail__comments">💬 {$commentCount} {$commentCount === 1 ? 'komentář' : ($commentCount < 5 ? 'komentáře' : 'komentářů')}</span>
                {/if}
            </div>
            <h1 itemprop="headline">{$pageTitle}</h1>
            {if $post->{'perex_' . $locale}}
                <p class="page-header__lead" itemprop="description">{$post->{'perex_' . $locale}}</p>
            {/if}
            {if $tags}
                <ul class="tag-list" style="margin-top:1.25rem;">
                    {foreach $tags as $tag}
                        <li class="tag"><a href="{link tag $tag}">{$tag}</a></li>
                    {/foreach}
                </ul>
            {/if}
        </div>
    </header>

    {if $post->cover_image}
    <div class="container">
        <img src="{$post->cover_image}" alt="{$post->{'title_' . $locale}}" class="post-detail__cover" itemprop="image" loading="eager" width="1200" height="630">
    </div>
    {/if}

    <div class="container">
        <div class="post-detail__layout">
            <div class="post-detail__content prose" itemprop="articleBody" id="post-content">
                {$postContent|noescape}
            </div>

            <aside class="post-detail__sidebar">
                {* Share *}
                <div class="sidebar-widget">
                    <strong>Sdílet článek</strong>
                    <a href="https://twitter.com/intent/tweet?url={$canonicalUrl|rawurlencode}&text={$post->{'title_' . $locale}|rawurlencode}"
                       target="_blank" rel="noopener" class="share-link share-link--twitter">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        Twitter / X
                    </a>
                    <a href="https://www.linkedin.com/sharing/share-offsite/?url={$canonicalUrl|rawurlencode}"
                       target="_blank" rel="noopener" class="share-link share-link--linkedin">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        LinkedIn
                    </a>
                    <button type="button" class="share-link share-link--copy" data-url="{$canonicalUrl}" aria-label="Kopírovat odkaz">
                        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"/><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/></svg>
                        Kopírovat odkaz
                    </button>
                </div>

                {* Tags *}
                {if $tags}
                <div class="sidebar-widget">
                    <strong>Štítky</strong>
                    <ul class="tag-list">
                        {foreach $tags as $tag}
                            <li class="tag"><a href="{link tag $tag}">{$tag}</a></li>
                        {/foreach}
                    </ul>
                </div>
                {/if}

                {* Author *}
                <div class="sidebar-widget">
                    <strong>Autor</strong>
                    <div style="display:flex; align-items:center; gap:0.75rem; margin-top:0.5rem;">
                        <div style="width:40px; height:40px; border-radius:50%; background:var(--c-bg-elevated); border:2px solid var(--c-border); display:flex; align-items:center; justify-content:center; font-size:1.25rem; flex-shrink:0;">M</div>
                        <div>
                            <div style="font-weight:700; font-size:0.9375rem;">Mathex</div>
                            <div style="color:var(--c-muted); font-size:0.8125rem;">PHP Developer</div>
                        </div>
                    </div>
                </div>

                {* Newsletter widget *}
                <div class="sidebar-widget sidebar-widget--newsletter">
                    <strong>Newsletter</strong>
                    <p>Nové články přímo do schránky.</p>
                    <form action="{link //Newsletter:subscribe}" method="post" class="sidebar-newsletter-form">
                        <input type="email" name="email" placeholder="vas@email.cz" required class="form-control form-control--sm" autocomplete="email">
                        <button type="submit" class="btn btn-primary btn-sm" style="width:100%;margin-top:0.5rem;">Přihlásit se</button>
                    </form>
                </div>
            </aside>
        </div>
    </div>

</article>

{* Back to top *}
<button class="back-to-top" id="backToTop" aria-label="Nahoru" title="Nahoru">
    <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5"><polyline points="18 15 12 9 6 15"/></svg>
</button>

{* Prev / Next navigation *}
{if $prevPost || $nextPost}
<nav class="post-navigation" aria-label="Další články">
    <div class="container">
        {if $prevPost}
        <a href="{link detail $prevPost->slug}" class="post-navigation__prev">
            <span>← Novější článek</span>
            <strong>{$prevPost->{'title_' . $locale}}</strong>
        </a>
        {else}<div></div>{/if}
        {if $nextPost}
        <a href="{link detail $nextPost->slug}" class="post-navigation__next">
            <span>Starší článek →</span>
            <strong>{$nextPost->{'title_' . $locale}}</strong>
        </a>
        {/if}
    </div>
</nav>
{/if}

{* Related posts *}
{if $relatedPosts}
<section class="section section--related">
    <div class="container">
        <h2 class="section__title reveal">Mohlo by vás zajímat</h2>
        <div class="posts-grid">
            {foreach $relatedPosts as $i => $related}
            <article class="post-card reveal reveal--delay-{min($i + 1, 3)}">
                {if $related->cover_image}
                <a href="{link detail $related->slug}" class="post-card__image-link" tabindex="-1" aria-hidden="true">
                    <img src="{$related->cover_image}" alt="{$related->{'title_' . $locale}}" class="post-card__image" loading="lazy">
                </a>
                {/if}
                <div class="post-card__body">
                    <div class="post-card__meta">
                        <time class="post-card__date">{$related->published_at|date:'j. n. Y'}</time>
                        {if $related->reading_time_min}<span class="post-card__reading">⏱ {$related->reading_time_min} min</span>{/if}
                    </div>
                    <h3 class="post-card__title"><a href="{link detail $related->slug}">{$related->{'title_' . $locale}}</a></h3>
                    {if $related->{'perex_' . $locale}}<p class="post-card__perex">{$related->{'perex_' . $locale}}</p>{/if}
                    <a href="{link detail $related->slug}" class="post-card__link">Číst →</a>
                </div>
            </article>
            {/foreach}
        </div>
    </div>
</section>
{/if}

{* ─── Comments ─────────────────────────────────────────────────────────────── *}
<section class="section section--comments" id="comments">
    <div class="container">
        <div class="comments-layout">

            <div class="comments-list">
                <h2 class="section__title">
                    {if $commentCount > 0}
                        {$commentCount} {$commentCount === 1 ? 'Komentář' : ($commentCount < 5 ? 'Komentáře' : 'Komentářů')}
                    {else}
                        Buďte první, kdo napíše komentář
                    {/if}
                </h2>

                {foreach $comments as $comment}
                <div class="comment">
                    <div class="comment__avatar" aria-hidden="true">{mb_strtoupper(mb_substr($comment->name, 0, 1))}</div>
                    <div class="comment__body">
                        <div class="comment__header">
                            <strong class="comment__name">{$comment->name}</strong>
                            <time class="comment__date">{$comment->created_at|date:'j. n. Y'}</time>
                        </div>
                        <p class="comment__text">{$comment->content|breakLines}</p>
                    </div>
                </div>
                {/foreach}
            </div>

            <div class="comment-form-wrap">
                <h3>Napsat komentář</h3>
                <p class="comment-form-note">Komentáře jsou před zveřejněním moderovány.</p>
                {form commentForm}
                    {input post_id}
                    <div class="form-group">
                        {label name}Jméno{/label}
                        {input name, class => 'form-control', placeholder => 'Vaše jméno'}
                        {inputError name}
                    </div>
                    <div class="form-group">
                        {label email}E-mail <small>(nebude zveřejněn)</small>{/label}
                        {input email, class => 'form-control', placeholder => 'vas@email.cz'}
                        {inputError email}
                    </div>
                    <div class="form-group" style="display:none" aria-hidden="true">
                        {input website}
                    </div>
                    <div class="form-group">
                        {label content}Komentář{/label}
                        {input content, class => 'form-control'}
                        {inputError content}
                    </div>
                    <div class="form-actions">
                        {input submit, class => 'btn btn-primary'}
                    </div>
                {/form}
            </div>

        </div>
    </div>
</section>

{block extraFoot}
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/prism.min.js"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/prism/1.29.0/plugins/autoloader/prism-autoloader.min.js"></script>
<script>
/* ─── Back to top ────────────────────────────────────────────────────────── */
(function() {
    const btn = document.getElementById('backToTop');
    if (!btn) return;
    window.addEventListener('scroll', () => {
        btn.classList.toggle('is-visible', window.scrollY > 600);
    }, { passive: true });
    btn.addEventListener('click', () => window.scrollTo({ top: 0, behavior: 'smooth' }));
})();

/* ─── Copy link ──────────────────────────────────────────────────────────── */
document.querySelectorAll('.share-link--copy').forEach(btn => {
    btn.addEventListener('click', async () => {
        const url = btn.dataset.url || window.location.href;
        try {
            await navigator.clipboard.writeText(url);
            const orig = btn.innerHTML;
            btn.innerHTML = '<svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><polyline points="20 6 9 17 4 12"/></svg> Zkopírováno!';
            setTimeout(() => { btn.innerHTML = orig; }, 2200);
        } catch {}
    });
});
</script>
{/block}

{/block}
