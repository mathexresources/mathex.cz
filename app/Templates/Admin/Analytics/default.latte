{block content}
<div class="admin-toolbar">
    <div class="admin-toolbar__filters">
        <div class="btn-group">
            <a href="{link default, range => '7'}" class="btn btn-sm {$activeRange === '7' ? 'btn-primary' : 'btn-outline'}">7 dní</a>
            <a href="{link default, range => '30'}" class="btn btn-sm {$activeRange === '30' ? 'btn-primary' : 'btn-outline'}">30 dní</a>
            <a href="{link default, range => '90'}" class="btn btn-sm {$activeRange === '90' ? 'btn-primary' : 'btn-outline'}">90 dní</a>
        </div>
        <span class="text-muted" style="margin-left:1rem">
            {$rangeFrom|date:'d.m.Y'} – {$rangeTo|date:'d.m.Y'}
        </span>
    </div>
    <div class="stat-inline">
        <span class="stat-inline__value">{$totalViews}</span>
        <span class="stat-inline__label">celkem zobrazení</span>
    </div>
</div>

<div class="dashboard-grid">
    <div class="admin-section" style="grid-column: 1 / -1">
        <div class="admin-section__header">
            <h2>Návštěvnost v čase</h2>
        </div>
        <div style="padding:1.5rem">
            <canvas id="analyticsChart" height="80"></canvas>
        </div>
    </div>

    <div class="admin-section">
        <div class="admin-section__header">
            <h2>Nejnavštěvovanější stránky</h2>
        </div>
        {if $topPages}
            <table class="data-table">
                <thead>
                    <tr>
                        <th>#</th>
                        <th>Stránka</th>
                        <th style="text-align:right">Zobrazení</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $topPages as $i => $page}
                <tr>
                    <td class="text-muted">{$i + 1}</td>
                    <td><code>{$page['path']}</code></td>
                    <td style="text-align:right"><strong>{$page['views']}</strong></td>
                </tr>
                {/foreach}
                </tbody>
            </table>
        {else}
            <p class="empty-state">Žádná data za zvolené období.</p>
        {/if}
    </div>

    <div class="admin-section">
        <div class="admin-section__header">
            <h2>Zdroje návštěvnosti</h2>
        </div>
        {if $referrers}
            <table class="data-table">
                <thead>
                    <tr>
                        <th>Referer</th>
                        <th style="text-align:right">Návštěv</th>
                    </tr>
                </thead>
                <tbody>
                {foreach $referrers as $ref}
                <tr>
                    <td>{$ref['referer'] ?: '<em class="text-muted">přímá návštěva</em>'|noescape}</td>
                    <td style="text-align:right">{$ref['views']}</td>
                </tr>
                {/foreach}
                </tbody>
            </table>
        {else}
            <p class="empty-state">Žádná data.</p>
        {/if}
    </div>
</div>

{block extraFoot}
<script src="https://cdn.jsdelivr.net/npm/chart.js@4/dist/chart.umd.min.js"></script>
<script>
(function() {
    const stats = {json_encode($visitorStats)};
    const labels = stats.map(s => s.date);
    const views  = stats.map(s => parseInt(s.views) || 0);
    const unique = stats.map(s => parseInt(s.unique_sessions) || 0);

    new Chart(document.getElementById('analyticsChart'), {
        type: 'line',
        data: {
            labels,
            datasets: [
                {
                    label: 'Zobrazení',
                    data: views,
                    borderColor: '#6366f1',
                    backgroundColor: 'rgba(99,102,241,0.12)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 3,
                },
                {
                    label: 'Unikátní relace',
                    data: unique,
                    borderColor: '#22c55e',
                    backgroundColor: 'rgba(34,197,94,0.08)',
                    tension: 0.4,
                    fill: true,
                    pointRadius: 3,
                }
            ]
        },
        options: {
            responsive: true,
            interaction: { mode: 'index', intersect: false },
            plugins: {
                legend: { labels: { color: '#e2e8f0' } },
                tooltip: { backgroundColor: '#1e293b', titleColor: '#e2e8f0', bodyColor: '#94a3b8' }
            },
            scales: {
                x: { ticks: { color: '#94a3b8', maxTicksLimit: 15 }, grid: { color: '#334155' } },
                y: { beginAtZero: true, ticks: { color: '#94a3b8', precision: 0 }, grid: { color: '#334155' } }
            }
        }
    });
})();
</script>
{/block}
{/block}
