{block content}
<div class="settings-layout">
    <nav class="settings-nav" id="settingsNav">
        <a href="#sec-general" class="settings-nav__link">Obecné</a>
        <a href="#sec-about" class="settings-nav__link">O mně</a>
        <a href="#sec-contact" class="settings-nav__link">Kontakt</a>
        <a href="#sec-seo" class="settings-nav__link">SEO</a>
        <a href="#sec-appearance" class="settings-nav__link">Vzhled</a>
        <a href="#sec-meetings" class="settings-nav__link">Schůzky</a>
    </nav>

    <div class="settings-body">
        {form settingsForm}

        <section id="sec-general" class="admin-section">
            <div class="admin-section__header"><h2>Obecné</h2></div>
            <div style="padding:1.5rem">
                <div class="form-group">
                    {label site_name /}
                    {input site_name, class => 'form-control'}
                    {inputError site_name}
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label tagline_cs /}
                        {input tagline_cs, class => 'form-control'}
                        {inputError tagline_cs}
                    </div>
                    <div class="form-group">
                        {label tagline_en /}
                        {input tagline_en, class => 'form-control'}
                        {inputError tagline_en}
                    </div>
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label logo_file /}
                        {input logo_file, class => 'form-control'}
                        {inputError logo_file}
                        {if isset($settings['logo_url']) && $settings['logo_url']}
                            <div style="margin-top:.5rem"><img src="{$settings['logo_url']}" alt="Logo" style="max-height:60px"></div>
                        {/if}
                    </div>
                    <div class="form-group">
                        {label favicon_file /}
                        {input favicon_file, class => 'form-control'}
                        {inputError favicon_file}
                        {if isset($settings['favicon_url']) && $settings['favicon_url']}
                            <div style="margin-top:.5rem"><img src="{$settings['favicon_url']}" alt="Favicon" style="max-height:32px"></div>
                        {/if}
                    </div>
                </div>
            </div>
        </section>

        <section id="sec-about" class="admin-section">
            <div class="admin-section__header"><h2>O mně</h2></div>
            <div style="padding:1.5rem">
                <div class="form-group">
                    {label profile_photo_file /}
                    {input profile_photo_file, class => 'form-control'}
                    {inputError profile_photo_file}
                    {if isset($settings['profile_photo_url']) && $settings['profile_photo_url']}
                        <div style="margin-top:.5rem"><img src="{$settings['profile_photo_url']}" alt="Profilová fotografie" style="max-height:80px;border-radius:50%"></div>
                    {/if}
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label bio_cs /}
                        {input bio_cs, class => 'form-control', rows => 6}
                        {inputError bio_cs}
                    </div>
                    <div class="form-group">
                        {label bio_en /}
                        {input bio_en, class => 'form-control', rows => 6}
                        {inputError bio_en}
                    </div>
                </div>
                <div class="form-group">
                    {label cv_file /}
                    {input cv_file, class => 'form-control'}
                    {inputError cv_file}
                    {if isset($settings['cv_url']) && $settings['cv_url']}
                        <small class="form-hint">Aktuální: <a href="{$settings['cv_url']}" target="_blank">stáhnout CV</a></small>
                    {/if}
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label github_url /}
                        {input github_url, class => 'form-control', placeholder => 'https://github.com/username'}
                        {inputError github_url}
                    </div>
                    <div class="form-group">
                        {label linkedin_url /}
                        {input linkedin_url, class => 'form-control', placeholder => 'https://linkedin.com/in/username'}
                        {inputError linkedin_url}
                    </div>
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label twitter_url /}
                        {input twitter_url, class => 'form-control', placeholder => 'https://twitter.com/username'}
                        {inputError twitter_url}
                    </div>
                    <div class="form-group">
                        {label instagram_url /}
                        {input instagram_url, class => 'form-control', placeholder => 'https://instagram.com/username'}
                        {inputError instagram_url}
                    </div>
                </div>
            </div>
        </section>

        <section id="sec-contact" class="admin-section">
            <div class="admin-section__header"><h2>Kontakt</h2></div>
            <div style="padding:1.5rem">
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label contact_email /}
                        {input contact_email, class => 'form-control'}
                        {inputError contact_email}
                    </div>
                    <div class="form-group">
                        {label contact_phone /}
                        {input contact_phone, class => 'form-control', placeholder => '+420 xxx xxx xxx'}
                        {inputError contact_phone}
                    </div>
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label contact_location /}
                        {input contact_location, class => 'form-control', placeholder => 'Praha, Česká republika'}
                        {inputError contact_location}
                    </div>
                    <div class="form-group">
                        {label working_hours /}
                        {input working_hours, class => 'form-control', placeholder => 'Po–Pá 9:00–17:00'}
                        {inputError working_hours}
                    </div>
                </div>
                <div class="form-group">
                    {label google_maps_embed /}
                    {input google_maps_embed, class => 'form-control', rows => 4}
                    {inputError google_maps_embed}
                    <small class="form-hint">Vložte celý &lt;iframe&gt; kód z Google Maps → Sdílet → Vložit mapu</small>
                </div>
            </div>
        </section>

        <section id="sec-seo" class="admin-section">
            <div class="admin-section__header"><h2>SEO</h2></div>
            <div style="padding:1.5rem">
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label meta_description_cs /}
                        {input meta_description_cs, class => 'form-control', rows => 3}
                        {inputError meta_description_cs}
                        <small class="form-hint">Doporučeno 150–160 znaků</small>
                    </div>
                    <div class="form-group">
                        {label meta_description_en /}
                        {input meta_description_en, class => 'form-control', rows => 3}
                        {inputError meta_description_en}
                    </div>
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label ga_tag /}
                        {input ga_tag, class => 'form-control', placeholder => 'G-XXXXXXXXXX'}
                        {inputError ga_tag}
                    </div>
                    <div class="form-group">
                        {label seo_keywords /}
                        {input seo_keywords, class => 'form-control', placeholder => 'web developer, PHP, Nette, Praha'}
                        {inputError seo_keywords}
                    </div>
                </div>
            </div>
        </section>

        <section id="sec-appearance" class="admin-section">
            <div class="admin-section__header"><h2>Vzhled</h2></div>
            <div style="padding:1.5rem">
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label accent_color /}
                        <div style="display:flex;gap:.5rem;align-items:center">
                            {input accent_color, class => 'form-control', id => 'accentColorText', style => 'flex:1'}
                            <input type="color" id="accentColorPicker" style="width:3rem;height:2.5rem;padding:.2rem;border-radius:4px;border:1px solid #475569;background:transparent;cursor:pointer">
                        </div>
                        {inputError accent_color}
                    </div>
                    <div class="form-group">
                        {label dark_mode_default /}
                        {input dark_mode_default, class => 'form-control'}
                        {inputError dark_mode_default}
                    </div>
                </div>
            </div>
        </section>

        <section id="sec-meetings" class="admin-section">
            <div class="admin-section__header"><h2>Schůzky</h2></div>
            <div style="padding:1.5rem">
                <div class="form-group">
                    {label meeting_available_times /}
                    {input meeting_available_times, class => 'form-control', placeholder => '09:00,10:00,11:00,13:00,14:00,15:00,16:00'}
                    {inputError meeting_available_times}
                    <small class="form-hint">Časy oddělené čárkou. Přiřazeny v časovém pásmu Europe/Prague.</small>
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label meeting_duration /}
                        {input meeting_duration, class => 'form-control', placeholder => '60'}
                        {inputError meeting_duration}
                    </div>
                    <div class="form-group">
                        {label webhook_url /}
                        {input webhook_url, class => 'form-control', placeholder => 'https://hooks.zapier.com/...'}
                        {inputError webhook_url}
                        <small class="form-hint">Webhook bude volán při nové / změněné schůzce (POST JSON).</small>
                    </div>
                </div>
                <div class="admin-section__header" style="margin:1.5rem -1.5rem 1rem;padding:0.75rem 1.5rem;font-size:0.875rem;color:var(--color-muted);font-weight:600;text-transform:uppercase;letter-spacing:0.06em">Google Calendar (volitelné)</div>
                <div class="form-group">
                    {input google_calendar_enabled}
                    {label google_calendar_enabled, style => 'display:inline;margin-left:.5rem' /}
                    {inputError google_calendar_enabled}
                </div>
                <div class="form-row form-row--two">
                    <div class="form-group">
                        {label google_calendar_id /}
                        {input google_calendar_id, class => 'form-control', placeholder => 'yourname@group.calendar.google.com'}
                        {inputError google_calendar_id}
                    </div>
                </div>
                <div class="form-group">
                    {label google_credentials_json /}
                    {input google_credentials_json, class => 'form-control', rows => 6, placeholder => '{"type":"service_account",...}'}
                    {inputError google_credentials_json}
                    <small class="form-hint">Vložte celý obsah JSON souboru Service Account z Google Cloud Console.</small>
                </div>
            </div>
        </section>

        <div class="form-actions" style="padding:1.5rem 0">
            {input save, class => 'btn btn-primary btn-lg'}
        </div>

        {/form}
    </div>
</div>

{block extraFoot}
<script>
// Sync color picker ↔ text input
const colorText   = document.getElementById('accentColorText');
const colorPicker = document.getElementById('accentColorPicker');
if (colorText && colorPicker) {
    colorPicker.value = colorText.value || '#6366f1';
    colorPicker.addEventListener('input', function() { colorText.value = this.value; });
    colorText.addEventListener('input', function() {
        if (/^#[0-9a-fA-F]{6}$/.test(this.value)) colorPicker.value = this.value;
    });
}

// Smooth scroll for settings nav
document.querySelectorAll('.settings-nav__link').forEach(link => {
    link.addEventListener('click', function(e) {
        e.preventDefault();
        const target = document.querySelector(this.getAttribute('href'));
        if (target) target.scrollIntoView({ behavior: 'smooth', block: 'start' });
    });
});
</script>
{/block}
{/block}
