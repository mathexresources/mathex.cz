{block content}
<div class="admin-toolbar">
    <p class="text-muted">Přetažením změňte pořadí dovedností v rámci skupiny.</p>
    <a href="{link edit}" class="btn btn-primary">+ Nová dovednost</a>
</div>

{if $grouped}
    {foreach $grouped as $category => $skills}
    <div class="admin-section">
        <div class="admin-section__header">
            <h2>
                {var $catLabels = ['backend' => 'Backend', 'frontend' => 'Frontend', 'devops' => 'DevOps', 'other' => 'Ostatní']}
                {$catLabels[$category] ?? $category}
            </h2>
        </div>
        <table class="data-table" id="table-{$category}">
            <thead>
                <tr>
                    <th style="width:24px"></th>
                    <th>Název</th>
                    <th>Ikona</th>
                    <th>Úroveň</th>
                    <th>Pořadí</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody class="sortable-skills" data-category="{$category}">
            {foreach $skills as $skill}
            <tr data-id="{$skill->id}">
                <td class="drag-handle" title="Přetáhnout">⠿</td>
                <td><strong>{$skill->name}</strong></td>
                <td>{$skill->icon_class ? "<i class=\"{$skill->icon_class}\"></i> {$skill->icon_class}" : '—'}</td>
                <td>
                    <div class="skill-bar-wrap">
                        <div class="skill-bar" style="width:{$skill->level}%"></div>
                    </div>
                    <small>{$skill->level} %</small>
                </td>
                <td>{$skill->order_index}</td>
                <td class="actions">
                    <a href="{link edit $skill->id}" class="btn btn-xs btn-outline">Upravit</a>
                    <a href="{link delete $skill->id}" class="btn btn-xs btn-danger"
                       onclick="return confirm('Opravdu smazat tuto dovednost?')">Smazat</a>
                </td>
            </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
    {/foreach}
{else}
    <p class="empty-state">Zatím žádné dovednosti. <a href="{link edit}">Přidat první</a></p>
{/if}

{block extraFoot}
<script src="https://cdn.jsdelivr.net/npm/sortablejs@1/Sortable.min.js"></script>
<script n:syntax="off">
document.querySelectorAll('.sortable-skills').forEach(tbody => {
    Sortable.create(tbody, {
        handle: '.drag-handle',
        animation: 150,
        onEnd: function() {
            const ids = [...tbody.querySelectorAll('tr[data-id]')].map(r => r.dataset.id);
            fetch('{link reorder}', {
                method: 'POST',
                headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
                body: ids.map((id, i) => `ids[${i}]=${id}`).join('&')
            });
        }
    });
});
</script>
{/block}
{/block}
