{block content}
<div class="login-wrap">
    <div class="login-box login-box--wide">
        <div class="login-box__logo">
            <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
        </div>
        <h1 class="login-box__title">První spuštění</h1>
        <p class="login-box__subtitle">Vytvořte administrátorský účet pro správu webu.</p>

        {form setupForm, class => 'login-form'}
            <div class="form-group">
                {label name /}
                {input name, class => 'form-control', autofocus => true, placeholder => 'Jan Novák'}
                {inputError name}
            </div>
            <div class="form-group">
                {label email /}
                {input email, class => 'form-control', placeholder => 'admin@mathex.cz'}
                {inputError email}
            </div>
            <div class="form-group">
                {label password /}
                {input password, class => 'form-control'}
                {inputError password}
            </div>
            <div class="form-group">
                {label password_confirm /}
                {input password_confirm, class => 'form-control'}
                {inputError password_confirm}
            </div>
            {input create, class => 'btn btn-primary btn--full'}
        {/form}
    </div>
</div>
{/block}
