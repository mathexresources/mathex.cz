{block content}
<div class="form-card">
    <h2 style="margin-bottom:1.5rem">Informace o účtu</h2>
    <table class="info-table">
        <tr><th>Jméno</th><td>{$adminUser->name}</td></tr>
        <tr><th>E-mail</th><td>{$adminUser->email}</td></tr>
        <tr><th>Role</th><td>{$adminUser->role}</td></tr>
        <tr><th>Poslední přihlášení</th><td>{$adminUser->last_login_at ? $adminUser->last_login_at|date:'d.m.Y H:i' : '—'}</td></tr>
    </table>

    <hr style="border-color: var(--color-border); margin: 2rem 0">

    <h2 style="margin-bottom:1.5rem">Změna hesla</h2>
    {form passwordForm}
        <div class="form-group">
            {label current_password /}
            {input current_password, class => 'form-control'}
            {inputError current_password}
        </div>
        <div class="form-row form-row--two">
            <div class="form-group">
                {label new_password /}
                {input new_password, class => 'form-control'}
                {inputError new_password}
            </div>
            <div class="form-group">
                {label new_password_confirm /}
                {input new_password_confirm, class => 'form-control'}
                {inputError new_password_confirm}
            </div>
        </div>
        <div class="form-actions">
            {input save, class => 'btn btn-primary'}
        </div>
    {/form}
</div>
{/block}
