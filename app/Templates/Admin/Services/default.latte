{block content}
<div class="admin-toolbar">
    <p class="text-muted">Spravujte nabízené služby.</p>
    <a href="{link edit}" class="btn btn-primary">+ Nová služba</a>
</div>

{if iterator_count($services) > 0}
    <div class="admin-section">
        <table class="data-table">
            <thead>
                <tr>
                    <th>Název</th>
                    <th>Slug</th>
                    <th>Ikona</th>
                    <th>Pořadí</th>
                    <th>Stav</th>
                    <th>Akce</th>
                </tr>
            </thead>
            <tbody>
            {foreach $services as $service}
            <tr>
                <td>
                    <strong>{$service->title_cs}</strong>
                    {if $service->title_en}<br><small class="text-muted">{$service->title_en}</small>{/if}
                </td>
                <td><code>{$service->slug}</code></td>
                <td>{$service->icon ?: '—'}</td>
                <td>{$service->order_index}</td>
                <td>
                    <a href="{link toggle $service->id}" class="badge {$service->active ? 'badge--green' : 'badge--gray'}">
                        {$service->active ? 'Aktivní' : 'Neaktivní'}
                    </a>
                </td>
                <td class="actions">
                    <a href="{link edit $service->id}" class="btn btn-xs btn-outline">Upravit</a>
                    <a href="{link delete $service->id}" class="btn btn-xs btn-danger"
                       onclick="return confirm('Opravdu smazat tuto službu?')">Smazat</a>
                </td>
            </tr>
            {/foreach}
            </tbody>
        </table>
    </div>
{else}
    <p class="empty-state">Zatím žádné služby. <a href="{link edit}">Přidat první</a></p>
{/if}
{/block}
