<!DOCTYPE html>
<html lang="{$locale}">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>{ifset $pageTitle}{$pageTitle} | {/ifset}{$siteTitle} – {if $locale === 'en'}Webdesign & Development{else}Webdesign & Vývoj{/if}</title>
    <meta name="description" content="{$metaDescription}">

    {* Canonical *}
    {if $canonicalUrl}<link rel="canonical" href="{$canonicalUrl}">{/if}

    {* Hreflang – alternate language versions *}
    <link rel="alternate" hreflang="cs" href="{$hreflangCsUrl}">
    <link rel="alternate" hreflang="en" href="{$hreflangEnUrl}">
    <link rel="alternate" hreflang="x-default" href="{$hreflangCsUrl}">

    {* Open Graph *}
    <meta property="og:type"        content="website">
    <meta property="og:site_name"   content="{$siteTitle}">
    <meta property="og:title"       content="{ifset $pageTitle}{$pageTitle} | {/ifset}{$siteTitle}">
    <meta property="og:description" content="{$metaDescription}">
    <meta property="og:locale"      content="{if $locale === 'en'}en_US{else}cs_CZ{/if}">
    <meta property="og:locale:alternate" content="{if $locale === 'en'}cs_CZ{else}en_US{/if}">
    {if $canonicalUrl}<meta property="og:url" content="{$canonicalUrl}">{/if}
    {if $ogImage}<meta property="og:image" content="{$ogImage}">{/if}

    {* Twitter Card *}
    <meta name="twitter:card"        content="summary_large_image">
    <meta name="twitter:title"       content="{ifset $pageTitle}{$pageTitle} | {/ifset}{$siteTitle}">
    <meta name="twitter:description" content="{$metaDescription}">
    {if $ogImage}<meta name="twitter:image" content="{$ogImage}">{/if}

    {* JSON-LD *}
    {if $jsonLd}
    <script type="application/ld+json">{$jsonLd|json_encode|noescape}</script>
    {/if}

    {* RSS feed *}
    <link rel="alternate" type="application/rss+xml" title="{$siteTitle} Blog RSS" href="/blog/feed.xml">

    {* Preconnect for Google Fonts CDN *}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:ital,opsz,wght@0,9..40,400;0,9..40,500;0,9..40,600;0,9..40,700;1,9..40,400&family=JetBrains+Mono:ital,wght@0,400;0,600;0,700;1,400&family=Space+Mono:ital,wght@0,400;0,700;1,400&display=swap" rel="stylesheet">

    {* Critical above-the-fold CSS *}
    <style n:syntax="off">
        :root{--c-bg:#0f0f13;--c-surface:#1a1a22;--c-text:#e8e8f0;--c-accent:#6366f1;--c-border:rgba(255,255,255,.08);font-size:16px}
        *,::before,::after{box-sizing:border-box;margin:0;padding:0}
        body{background:var(--c-bg);color:var(--c-text);font-family:'DM Sans',system-ui,sans-serif;line-height:1.6;min-height:100vh}
        .site-header{position:sticky;top:0;z-index:100;background:rgba(15,15,19,.85);backdrop-filter:blur(12px);border-bottom:1px solid var(--c-border)}
        .site-header .container{display:flex;align-items:center;gap:1rem;padding:.875rem 1.5rem;max-width:1200px;margin:0 auto}
        .logo{font-family:'Space Mono',monospace;font-weight:700;color:var(--c-accent);text-decoration:none;font-size:1.125rem}
        .main-nav{display:flex;gap:.25rem;align-items:center;margin-left:auto}
        .nav-link{padding:.4rem .75rem;border-radius:6px;color:var(--c-text);text-decoration:none;font-size:.9rem;font-weight:500;transition:color .15s,background .15s}
        .nav-link:hover,.nav-link.active{color:var(--c-accent);background:rgba(99,102,241,.1)}
        .main-content{min-height:70vh}
        .container{max-width:1200px;margin:0 auto;padding:0 1.5rem}
    </style>

    <link rel="stylesheet" href="{$basePath}assets/css/style.css">
    <link rel="icon" type="image/svg+xml" href="{$basePath}assets/images/favicon.svg">

    {* Google Analytics 4 – only injected after cookie consent *}
    {if $gaTag}
    <script id="ga4-placeholder" data-ga-tag="{$gaTag}" type="text/plain"></script>
    {/if}
</head>
<body class="{$presenter->getName()|lower|replace(':', '-')}">

{* Custom cursor *}
<div class="cursor" aria-hidden="true">
    <div class="cursor__dot"></div>
    <div class="cursor__ring"></div>
</div>

{* ─── Navigation ──────────────────────────────────────────────────────────── *}
<header class="site-header">
    <div class="container">
        <a class="logo" href="{link Homepage:}" aria-label="{$siteTitle}">{$siteTitle}</a>

        <nav class="main-nav" id="main-nav" aria-label="{_'nav.aria_main_nav'}">
            <a href="{link Homepage:}"  n:class="'nav-link', $presenter->isLinkCurrent('Homepage:*') ? 'active'">{_'nav.home'}</a>
            <a href="{link Blog:}"      n:class="'nav-link', $presenter->isLinkCurrent('Blog:*') ? 'active'">{_'nav.blog'}</a>
            <a href="{link Projects:}"  n:class="'nav-link', $presenter->isLinkCurrent('Projects:*') ? 'active'">{_'nav.projects'}</a>
            <a href="{link Services:}"  n:class="'nav-link', $presenter->isLinkCurrent('Services:*') ? 'active'">{_'nav.services'}</a>
            <a href="{link Pricing:}"   n:class="'nav-link', $presenter->isLinkCurrent('Pricing:*') ? 'active'">{_'nav.pricing'}</a>
            <a href="{link About:}"     n:class="'nav-link', $presenter->isLinkCurrent('About:*') ? 'active'">{_'nav.about'}</a>
            <a href="{link Contact:}"   n:class="'nav-link', $presenter->isLinkCurrent('Contact:*') ? 'active'">{_'nav.contact'}</a>
            <a href="{link Meeting:}"   class="nav-link nav-link--cta">{_'nav.booking'}</a>
            {if $user->isLoggedIn()}
                <a href="{link Admin:Dashboard:}" class="nav-link nav-link--admin">{_'nav.admin'}</a>
            {/if}
        </nav>

        <div class="lang-switcher" aria-label="{_'lang.aria'}">
            <a href="{$hreflangCsUrl}" n:class="'lang-switcher__link', $locale === 'cs' ? 'lang-switcher__link--active'">{_'lang.switch_cs'}</a>
            <a href="{$hreflangEnUrl}" n:class="'lang-switcher__link', $locale === 'en' ? 'lang-switcher__link--active'">{_'lang.switch_en'}</a>
        </div>

        <button class="nav-toggle" aria-label="{_'nav.aria_open_menu'}" aria-expanded="false" aria-controls="main-nav">
            <span></span><span></span><span></span>
        </button>
    </div>
</header>

{* ─── Main content ─────────────────────────────────────────────────────────── *}
<main class="main-content">
    {foreach $flashes as $flash}
        <div class="flash flash--{$flash->type}" role="alert">{$flash->message}</div>
    {/foreach}

    {include content}
</main>

{* ─── Footer ───────────────────────────────────────────────────────────────── *}
<footer class="site-footer" aria-label="{if $locale === 'en'}Footer{else}Patička{/if}">
    <div class="container">
        <div class="footer-grid">
            <div class="footer-grid__brand">
                <a class="logo" href="{link Homepage:}">{$siteTitle}</a>
                <p style="white-space:pre-line">{_'footer.brand_desc'}</p>
            </div>

            <nav class="footer-grid__nav" aria-label="{_'footer.nav'}">
                <strong>{_'footer.nav'}</strong>
                <a href="{link Homepage:}">{_'nav.home'}</a>
                <a href="{link Blog:}">{_'nav.blog'}</a>
                <a href="{link Projects:}">{_'nav.projects'}</a>
                <a href="{link Services:}">{_'nav.services'}</a>
                <a href="{link Pricing:}">{_'nav.pricing'}</a>
                <a href="{link About:}">{_'nav.about'}</a>
            </nav>

            <div class="footer-grid__contact">
                <strong>{_'footer.contact'}</strong>
                <a href="mailto:info@mathex.cz">info@mathex.cz</a>
                <a href="{link Contact:}">{_'footer.contact_form'}</a>
                <a href="{link Meeting:}">{_'footer.book_call'}</a>
            </div>

            <div class="footer-grid__social">
                <strong>{_'footer.social'}</strong>
                <div class="footer-social">
                    <a href="https://github.com/mathex" target="_blank" rel="noopener noreferrer" class="footer-social__link">
                        <svg class="footer-social__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0 1 12 6.844a9.59 9.59 0 0 1 2.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0 0 22 12.017C22 6.484 17.522 2 12 2z"/></svg>
                        GitHub
                    </a>
                    <a href="https://linkedin.com/in/mathex" target="_blank" rel="noopener noreferrer" class="footer-social__link">
                        <svg class="footer-social__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                        LinkedIn
                    </a>
                    <a href="https://twitter.com/mathex" target="_blank" rel="noopener noreferrer" class="footer-social__link">
                        <svg class="footer-social__icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-4.714-6.231-5.401 6.231H2.74l7.73-8.835L1.254 2.25H8.08l4.259 5.63zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>
                        Twitter / X
                    </a>
                </div>
            </div>
        </div>

        <div class="footer-bottom">
            <p>&copy; {date('Y')} {$siteTitle} &mdash; {_'footer.copy'}</p>
            <span class="footer-bottom__made">{_'footer.made_in'}</span>
            <a href="/sitemap.xml">{_'footer.sitemap'}</a>
            <a href="{link Privacy:, locale: ($locale === 'en' ? 'en' : null)}">{_'cookie.privacy_link'}</a>
        </div>
    </div>
</footer>

{* ─── Cookie consent ────────────────────────────────────────────────────────── *}
<div class="cookie-banner" id="cookie-banner" role="dialog" aria-label="{_'cookie.aria'}" aria-live="polite" hidden>
    <p>
        {_'cookie.text'}
        <a href="{link Privacy:, locale: ($locale === 'en' ? 'en' : null)}">{_'cookie.privacy_link'}</a>.
    </p>
    <div class="cookie-banner__actions">
        <button class="btn btn-primary btn-sm cookie-banner__accept">{_'cookie.accept'}</button>
        <button class="btn btn-ghost btn-sm cookie-banner__decline">{_'cookie.decline'}</button>
    </div>
</div>

<script src="{$basePath}assets/js/app.js" defer></script>
</body>
</html>
