{block content}

{* ─── Hero ──────────────────────────────────────────────────────────────────── *}
<section class="hero">
    <div class="hero__orb hero__orb--1" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--2" aria-hidden="true"></div>
    <div class="hero__orb hero__orb--3" aria-hidden="true"></div>
    <div class="container">
        <div class="hero__inner">
            <div class="hero__content">
                <span class="hero__eyebrow">Freelance vývojář</span>
                <h1 class="hero__title">
                    Weby, které<br>
                    <span class="highlight">vydělávají.</span>
                </h1>
                <p class="hero__lead">
                    PHP, Nette Framework, REST API, Vue.js.<br>
                    Vyvíjím pro firmy i startupy po celé ČR.
                </p>
                <p class="hero__typewriter">
                    Specializuji se na&nbsp;<span class="tw-text" data-phrases='["PHP & Nette vývoj","REST API design","Vue.js aplikace","E-shop řešení","Technický konzulting"]'></span><span class="tw-cursor" aria-hidden="true"></span>
                </p>
                <div class="hero__actions">
                    <a href="{link Meeting:}" class="btn btn-primary btn--large">
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
                        Rezervovat call
                    </a>
                    <a href="{link Projects:}" class="btn btn-outline btn--large">Moje projekty →</a>
                </div>
            </div>

            {* Terminal code window *}
            <div class="hero__terminal" aria-hidden="true">
                <div class="terminal">
                    <div class="terminal__bar">
                        <span class="terminal__dot terminal__dot--red"></span>
                        <span class="terminal__dot terminal__dot--yellow"></span>
                        <span class="terminal__dot terminal__dot--green"></span>
                        <span class="terminal__filename">FreelanceApp.php</span>
                    </div>
                    <div class="terminal__body">
<div class="terminal__line"><span class="t-comment">// mathex.cz – precision engineering</span></div>
<div class="terminal__line">&nbsp;</div>
<div class="terminal__line"><span class="t-keyword">class</span> <span class="t-class">FreelanceApp</span></div>
<div class="terminal__line">&#123;</div>
<div class="terminal__line t-indent"><span class="t-keyword">public function</span> <span class="t-fn">buildProject</span>(): <span class="t-class">Result</span></div>
<div class="terminal__line t-indent">&#123;</div>
<div class="terminal__line t-indent-2"><span class="t-var">$result</span> = <span class="t-var">$this</span>-&gt;<span class="t-fn">analyze</span>(<span class="t-var">$yourNeeds</span>);</div>
<div class="terminal__line t-indent-2"><span class="t-var">$result</span>-&gt;<span class="t-fn">design</span>()-&gt;<span class="t-fn">develop</span>()-&gt;<span class="t-fn">deploy</span>();</div>
<div class="terminal__line t-indent-2"><span class="t-keyword">return</span> <span class="t-fn">Result</span>::<span class="t-fn">success</span>();</div>
<div class="terminal__line t-indent">&#125;</div>
<div class="terminal__line">&#125;</div>
<div class="terminal__line terminal__line--cursor">&nbsp;</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{* ─── Stats bar ──────────────────────────────────────────────────────────────── *}
<section class="section--stats" aria-label="Statistiky">
    <div class="container">
        <ul class="stats-grid">
            <li class="stats-grid__item">
                <span class="stats-grid__number" data-count="{$stats['years']}" data-suffix="+">{$stats['years']}+</span>
                <span class="stats-grid__label">let zkušeností</span>
            </li>
            <li class="stats-grid__item">
                <span class="stats-grid__number" data-count="{$stats['projects']}" data-suffix="+">{$stats['projects']}+</span>
                <span class="stats-grid__label">dokončených projektů</span>
            </li>
            <li class="stats-grid__item">
                <span class="stats-grid__number" data-count="{$stats['clients']}" data-suffix="+">{$stats['clients']}+</span>
                <span class="stats-grid__label">spokojených klientů</span>
            </li>
            <li class="stats-grid__item">
                <span class="stats-grid__number" data-count="{$stats['satisfaction']}" data-suffix="%">{$stats['satisfaction']}%</span>
                <span class="stats-grid__label">spokojenost</span>
            </li>
        </ul>
    </div>
</section>

{* ─── Services ───────────────────────────────────────────────────────────────── *}
<section class="section section--services">
    <div class="container">
        <div class="section__title-group reveal">
            <span class="section__eyebrow">Co dělám</span>
            <h2 class="section__title">Od návrhu po nasazení</h2>
            <p class="section__lead">Komplexní řešení webových aplikací – čistý kód, dobrá architektura, spolehlivé dodání.</p>
        </div>
        <div class="services-grid">
            {foreach $services as $i => $service}
            <article class="service-card reveal reveal--delay-{min($i + 1, 4)}">
                {if $service->icon}<div class="service-card__icon">{$service->icon}</div>{/if}
                <h3>{$service->{'title_' . $locale}}</h3>
                <p>{$service->{'description_' . $locale}}</p>
                <a href="{link Services:}" class="service-card__link">Více informací →</a>
            </article>
            {else}
            <article class="service-card reveal reveal--delay-1">
                <div class="service-card__icon">⚡</div>
                <h3>Webové aplikace</h3>
                <p>Robustní PHP / Nette aplikace s čistou architekturou a dlouhodobou udržitelností.</p>
                <a href="{link Services:}" class="service-card__link">Více informací →</a>
            </article>
            <article class="service-card reveal reveal--delay-2">
                <div class="service-card__icon">🛒</div>
                <h3>E-shopy</h3>
                <p>Výkonná a přehledná řešení pro online prodej s integrací platebních bran.</p>
                <a href="{link Services:}" class="service-card__link">Více informací →</a>
            </article>
            <article class="service-card reveal reveal--delay-3">
                <div class="service-card__icon">🔌</div>
                <h3>REST API</h3>
                <p>Návrh a implementace RESTful API pro mobilní aplikace a systémové integrace.</p>
                <a href="{link Services:}" class="service-card__link">Více informací →</a>
            </article>
            <article class="service-card reveal reveal--delay-4">
                <div class="service-card__icon">🎯</div>
                <h3>Technické poradenství</h3>
                <p>Code review, architektonické konzultace a mentoring vývojových týmů.</p>
                <a href="{link Services:}" class="service-card__link">Více informací →</a>
            </article>
            {/foreach}
        </div>
        <div class="text-center mt-lg reveal">
            <a href="{link Services:}" class="btn btn-outline">Všechny služby</a>
        </div>
    </div>
</section>

{* ─── Featured Projects ──────────────────────────────────────────────────────── *}
{if $featuredProjects->count() > 0}
<section class="section section--featured-projects" style="background: var(--c-bg-card); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border);">
    <div class="container">
        <div class="section__title-group reveal">
            <span class="section__eyebrow">Portfolio</span>
            <h2 class="section__title">Vybrané projekty</h2>
            <p class="section__lead">Webové aplikace, e-shopy a API systémy, které jsem postavil pro klienty z celé ČR.</p>
        </div>
        <div class="projects-grid">
            {foreach $featuredProjects as $project}
            <article class="project-card reveal">
                {if $project->cover_image}
                    <a href="{link Projects:detail $project->slug}" class="project-card__image-link" tabindex="-1" aria-hidden="true">
                        <img src="{$project->cover_image}" alt="{$project->title}" class="project-card__image" loading="lazy">
                    </a>
                {/if}
                <div class="project-card__body">
                    <span class="project-card__category">{$project->category}</span>
                    <h3 class="project-card__title">
                        <a href="{link Projects:detail $project->slug}">{$project->title}</a>
                    </h3>
                    {if $project->{'description_' . $locale}}
                        <p class="project-card__desc">{$project->{'description_' . $locale}}</p>
                    {/if}
                    {if $project->technologies}
                        <ul class="tag-list">
                            {foreach json_decode($project->technologies, true) ?? [] as $tech}
                                <li class="tag">{$tech}</li>
                            {/foreach}
                        </ul>
                    {/if}
                    <a href="{link Projects:detail $project->slug}" class="btn btn-sm btn-outline">Case study →</a>
                </div>
            </article>
            {/foreach}
        </div>
        <div class="text-center mt-lg reveal">
            <a href="{link Projects:}" class="btn btn-outline">Všechny projekty</a>
        </div>
    </div>
</section>
{/if}

{* ─── Why Me ─────────────────────────────────────────────────────────────────── *}
<section class="section section--why-me">
    <div class="container">
        <div class="why-me-grid">
            <div class="reveal reveal--left">
                <span class="section__eyebrow">Proč já?</span>
                <h2 class="why-me__headline">Nižší náklady.<br>Stejná kvalita.</h2>
                <p class="why-me__lead">
                    Jako freelancer pracuji bez zbytečných mezičlánků a přímých nákladů velké agentury.
                    Dostanete senior vývojáře za cenu juniorního agenturního týmu.
                </p>
                <ul class="why-benefits">
                    <li>Přímá komunikace – žádný project manager navíc</li>
                    <li>Flexibilní kapacita podle vašich potřeb</li>
                    <li>Kód, který skutečně rozumíte a vlastníte</li>
                    <li>Rychlejší iterace a kratší time-to-market</li>
                    <li>Transparentní ceny a reportování</li>
                </ul>
                <div style="margin-top: 2rem;">
                    <a href="{link Pricing:}" class="btn btn-outline">Zobrazit ceník →</a>
                </div>
            </div>
            <div class="reveal reveal--right">
                <div class="comparison-card">
                    <div class="comparison-card__header">
                        <div class="comparison-card__col"></div>
                        <div class="comparison-card__col">Agentura</div>
                        <div class="comparison-card__col me">Mathex.cz</div>
                    </div>
                    <div class="comparison-card__row">
                        <div class="comparison-card__cell">Komunikace</div>
                        <div class="comparison-card__cell bad">Přes PM</div>
                        <div class="comparison-card__cell me">Přímo</div>
                    </div>
                    <div class="comparison-card__row">
                        <div class="comparison-card__cell">Cena/hod</div>
                        <div class="comparison-card__cell bad">3 000–6 000 Kč</div>
                        <div class="comparison-card__cell me">1 200–2 500 Kč</div>
                    </div>
                    <div class="comparison-card__row">
                        <div class="comparison-card__cell">Reakce</div>
                        <div class="comparison-card__cell bad">1–3 dny</div>
                        <div class="comparison-card__cell me">Do 24 hodin</div>
                    </div>
                    <div class="comparison-card__row">
                        <div class="comparison-card__cell">Flexibilita</div>
                        <div class="comparison-card__cell bad">Nízká</div>
                        <div class="comparison-card__cell me">Vysoká</div>
                    </div>
                    <div class="comparison-card__row">
                        <div class="comparison-card__cell">Záruky</div>
                        <div class="comparison-card__cell bad">Smluvní</div>
                        <div class="comparison-card__cell me">Výsledky</div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

{* ─── Testimonials ───────────────────────────────────────────────────────────── *}
{if $testimonials->count() > 0}
<section class="section section--testimonials" style="background: var(--c-bg-card); border-top: 1px solid var(--c-border); border-bottom: 1px solid var(--c-border);">
    <div class="container">
        <div class="section__title-group reveal text-center">
            <span class="section__eyebrow">Reference</span>
            <h2 class="section__title">Co říkají klienti</h2>
        </div>

        <div class="testimonials-carousel">
            <div class="testimonials-track">
                {foreach $testimonials as $t}
                <blockquote class="testimonial-card">
                    {if $t->rating}
                    <div class="testimonial-card__stars" aria-label="Hodnocení {$t->rating} z 5">
                        {for $star = 1; $star <= 5; $star++}
                            {if $star <= $t->rating}★{else}☆{/if}
                        {/for}
                    </div>
                    {/if}
                    <p class="testimonial-card__text">{$t->{'text_' . $locale}}</p>
                    <footer class="testimonial-card__author">
                        {if $t->avatar_url}
                            <img src="{$t->avatar_url}" alt="{$t->client_name}" class="testimonial-card__avatar" loading="lazy">
                        {else}
                            <div class="testimonial-card__avatar" style="background: var(--c-bg-elevated); display:flex; align-items:center; justify-content:center; font-size:1.25rem;">{$t->client_name[0]}</div>
                        {/if}
                        <div>
                            <strong>{$t->client_name}</strong>
                            {if $t->client_company}<span>{$t->client_company}</span>{/if}
                        </div>
                    </footer>
                </blockquote>
                {/foreach}
            </div>

            {if $testimonials->count() > 1}
            <div class="carousel-controls">
                <button class="carousel-btn carousel-btn--prev" aria-label="Předchozí">‹</button>
                <div class="carousel-dots">
                    {foreach $testimonials as $i => $t}
                        <button class="carousel-dot {if $i === 0}active{/if}" aria-label="Posudek {$i + 1}"></button>
                    {/foreach}
                </div>
                <button class="carousel-btn carousel-btn--next" aria-label="Další">›</button>
            </div>
            {/if}
        </div>
    </div>
</section>
{/if}

{* ─── Blog ────────────────────────────────────────────────────────────────────── *}
{if $featuredPosts->count() > 0}
<section class="section section--blog">
    <div class="container">
        <div class="section__title-group reveal">
            <span class="section__eyebrow">Znalosti</span>
            <h2 class="section__title">Z blogu</h2>
            <p class="section__lead">PHP, Nette, webový vývoj a freelance život. Sdílím co vím.</p>
        </div>
        <div class="posts-grid">
            {foreach $featuredPosts as $i => $post}
            <article class="post-card reveal reveal--delay-{min($i + 1, 3)}">
                {if $post->cover_image}
                    <a href="{link Blog:detail $post->slug}" class="post-card__image-link" tabindex="-1" aria-hidden="true">
                        <img src="{$post->cover_image}" alt="{$post->{'title_' . $locale}}" class="post-card__image" loading="lazy">
                    </a>
                {/if}
                <div class="post-card__body">
                    <div class="post-card__meta">
                        <time class="post-card__date" datetime="{$post->published_at}">{$post->published_at|date:'j. n. Y'}</time>
                    </div>
                    <h3 class="post-card__title">
                        <a href="{link Blog:detail $post->slug}">{$post->{'title_' . $locale}}</a>
                    </h3>
                    {if $post->{'perex_' . $locale}}<p class="post-card__perex">{$post->{'perex_' . $locale}}</p>{/if}
                    <a href="{link Blog:detail $post->slug}" class="post-card__link">Číst článek →</a>
                </div>
            </article>
            {/foreach}
        </div>
        <div class="text-center mt-lg reveal">
            <a href="{link Blog:}" class="btn btn-outline">Všechny články</a>
        </div>
    </div>
</section>
{/if}

{* ─── CTA ─────────────────────────────────────────────────────────────────────── *}
<section class="section section--cta" style="background: var(--c-bg-card); border-top: 1px solid var(--c-border);">
    <div class="container">
        <div class="cta-box reveal">
            <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--c-accent)" stroke-width="1.5" style="margin: 0 auto 1.5rem" aria-hidden="true"><rect x="3" y="4" width="18" height="18" rx="2"/><line x1="16" y1="2" x2="16" y2="6"/><line x1="8" y1="2" x2="8" y2="6"/><line x1="3" y1="10" x2="21" y2="10"/></svg>
            <h2>Máte projekt na mysli?</h2>
            <p>Rezervujte si bezplatný 30minutový discovery call.<br>Probereme vše na místě – bez závazků, bez salespitche.</p>
            <div class="cta-box__actions">
                <a href="{link Meeting:}" class="btn btn-primary btn--large">Rezervovat call zdarma</a>
                <a href="{link Contact:}" class="btn btn-outline">Napsat zprávu</a>
            </div>
        </div>
    </div>
</section>

{/block}
