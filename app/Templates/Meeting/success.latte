{block content}

<section class="section section--success">
    <div class="container">
        <div class="success-wrap text-center">
            <div class="success-icon" aria-label="Úspěch" role="img">✅</div>
            <h1>Rezervace přijata!</h1>
            <p>
                Děkuji za zájem o spolupráci.<br>
                Potvrzení jsem vám zaslal na e-mail. Ozvu se do 24 hodin s potvrzením termínu.
            </p>
            <div class="cta-box__actions" style="justify-content:center;">
                <a href="{link Homepage:}" class="btn btn-primary">Zpět na úvodní stránku</a>
                <a href="{link Projects:}" class="btn btn-outline">Prohlédnout projekty</a>
            </div>
        </div>
    </div>
</section>

{/block}
